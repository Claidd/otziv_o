FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46

ENV NODE_ENV=production
ENV HOME=/tmp/whatsapp-home \
    XDG_CACHE_HOME=/tmp/whatsapp-cache

# Установка зависимостей Chromium, curl и сертификатов
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-sandbox \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libx11-xcb1 \
    libnss3 \
    libnspr4 \
    libxss1 \
    xdg-utils \
    wget \
    curl \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libgdk-pixbuf2.0-0 \
    libdbus-1-3 \
    libxshmfence1 \
    --no-install-recommends && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Обновление сертификатов
RUN update-ca-certificates

# Указание Puppeteer использовать системный Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY whatsapp/package.json whatsapp/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node whatsapp/ ./

RUN mkdir -p /auth "$HOME" "$XDG_CACHE_HOME" \
    && chown -R node:node /app /auth "$HOME" "$XDG_CACHE_HOME"

USER node

CMD ["node", "index.js"]











