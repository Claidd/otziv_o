FROM node:22-bookworm-slim

ENV NODE_ENV=production

# Установка зависимостей Chromium, curl и сертификатов
RUN apt-get update && apt-get install -y \
    chromium \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libx11-xcb1 \
    libnss3 \
    libnspr4 \
    libxss1 \
    xdg-utils \
    wget \
    curl \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libgdk-pixbuf2.0-0 \
    libdbus-1-3 \
    libxshmfence1 \
    --no-install-recommends && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Обновление сертификатов
RUN update-ca-certificates

# Указание Puppeteer использовать системный Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY whatsapp/package.json whatsapp/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY whatsapp/ ./

# Deliberately remains root during the compatibility rollout: existing /auth
# bind mounts may be owned by different host UIDs. See the R7 rollout guide
# before switching to a fixed non-root UID.

CMD ["node", "index.js"]











