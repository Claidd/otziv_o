{
  "name": "mobile",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4300 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:local": "ng build --configuration development",
    "build:local:push": "powershell -ExecutionPolicy Bypass -File ./scripts/assert-android-firebase.ps1 && ng build --configuration development-push",
    "build:prod": "ng build --configuration production",
    "build:prod:push": "powershell -ExecutionPolicy Bypass -File ./scripts/assert-android-firebase.ps1 && ng build --configuration production-push",
    "test:unit": "node --test test/*.test.mjs",
    "typecheck": "ng build --configuration development",
    "verify": "npm run test:unit && npm run test:runtime && npm run build",
    "verify:prod": "npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:local": "npm run build:local && npx cap sync",
    "cap:sync:local:push": "npm run build:local:push && npx cap sync",
    "cap:sync:prod": "npm run build:prod && npx cap sync",
    "cap:sync:prod:push": "npm run build:prod:push && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:android:local": "npm run cap:sync:local && npx cap open android",
    "cap:android:prod": "npm run cap:sync:prod && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:ios:local": "npm run cap:sync:local && npx cap open ios",
    "cap:ios:prod": "npm run cap:sync:prod && npx cap open ios",
    "android:run:local": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-local.ps1",
    "android:run:local:push": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-local.ps1 -Push",
    "test:runtime": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "9.0.8",
    "@otziv/client-common": "file:../shared/client-common",
    "ionicons": "8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "jsdom": "28.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@modelcontextprotocol/sdk": "1.32.1",
    "@hono/node-server": "2.0.12",
    "@angular/build": {
      "undici": "7.30.1",
      "piscina": "5.3.2"
    },
    "jsdom": {
      "undici": "7.30.1"
    },
    "node-gyp": {
      "undici": "6.29.1"
    },
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "vite": "8.3.3",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
