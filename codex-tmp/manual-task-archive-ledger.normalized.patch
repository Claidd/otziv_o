+        }
+        ManualPaymentTaskSourceRef source = new ManualPaymentTaskSourceRef(
+                sourceKind, sourceId, sourceGeneration);
+        requireSourceTask(history, task.getId());
+        return new LockedArchivedReturnSource(source, returned);
+    }
