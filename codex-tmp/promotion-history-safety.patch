+    @Test
+    void terminalUnknownExposureBlocksButZeroExposureHistoryMayKeepOldRecipient() {
+        for (String status : new String[]{"COMPLETED", "CANCELED"}) {
+            clearRows();
+            insertTask(1L, "UNRESOLVED", null, status);
+            insertLedger(1L, 11L, "LEGACY-11", 0L, 100_000L, false);
+            assertThat(anomalies()).as(status + " unresolved legacy receipt").isPositive();
+        }
+
+        clearRows();
+        insertTask(1L, "UNRESOLVED", null, "COMPLETED");
+        insertLedger(1L, 11L, "LEGACY-11", 0L, 100_000L, false);
+        insertLedger(1L, 11L, "LEGACY-11", 0L, -100_000L, true);
+        assertThat(anomalies()).as("fully returned exact legacy receipt").isZero();
+
+        clearRows();
+        insertTask(2L, "SPECIALIST", 20L, "ACTIVE");
+        insertLedger(2L, 21L, "old-a", 100_000L, 0L, true);
+        insertLedger(2L, 21L, "old-a", -100_000L, 0L, true);
+        insertAllocation(21L, 2L, 10L, 100_000L, 0L, 0L, "RELEASED", 21L);
+        assertThat(anomalies()).as("released old recipient after retarget").isZero();
+
+        clearRows();
+        insertTask(3L, "SPECIALIST", 20L, "ACTIVE");
+        insertLedger(3L, 31L, "old-a", 0L, 100_000L, true);
+        insertLedger(3L, 31L, "old-a", 0L, -100_000L, true);
+        insertAllocation(31L, 3L, 10L, 100_000L, 100_000L, 100_000L, "CONFIRMED", 31L);
+        insertAttribution(301L, 3L, 10L, 31L, 100_000L);
+        assertThat(anomalies()).as("fully returned old recipient after retarget").isZero();
+
+        jdbc.update("DELETE FROM manual_payment_task_ledger_entries");
+        insertLedger(3L, 31L, "old-a", 0L, 100_000L, true);
+        jdbc.update("""
+                UPDATE contractor_payment_allocations
+                SET returned_kopecks = 0
+                WHERE id = 31
+                """);
+        assertThat(anomalies()).as("positive exposure on old recipient").isPositive();
+    }
