+    private long anomalies() {
+        Long count = jdbc.queryForObject(promotionQuery, Long.class);
+        return count == null ? -1L : count;
+    }
+
+    private void clearRows() {
+        jdbc.update("DELETE FROM contractor_actual_payment_attributions");
+        jdbc.update("DELETE FROM contractor_payment_allocations");
+        jdbc.update("DELETE FROM manual_payment_task_ledger_entries");
+        jdbc.update("DELETE FROM manual_payment_tasks");
+    }
+
+    private void insertTask(Long id, String kind, Long profileId, String status) {
+        jdbc.update("""
+                INSERT INTO manual_payment_tasks
+                    (id, accounting_target_kind, accounting_target_profile_id, status)
+                VALUES (?, ?, ?, ?)
+                """, id, kind, profileId, status);
+    }
+
+    private void insertLedger(
+            Long taskId,
+            Long sourceId,
+            String generation,
+            long reserved,
+            long confirmed,
+            boolean verified
+    ) {
+        jdbc.update("""
+                INSERT INTO manual_payment_task_ledger_entries
+                    (task_id, source_kind, source_id, source_generation,
+                     reserved_delta_kopecks, confirmed_delta_kopecks, verified)
+                VALUES (?, 'PAYMENT_LINK', ?, ?, ?, ?, ?)
+                """, taskId, sourceId, generation, reserved, confirmed, verified);
+    }
+
+    private void insertAllocation(
+            Long id,
+            Long taskId,
+            Long profileId,
+            long amount,
+            long confirmed,
+            long returned,
+            String status,
+            Long sourceId
+    ) {
+        jdbc.update("""
+                INSERT INTO contractor_payment_allocations
+                    (id, manual_payment_task_id, recipient_profile_id, amount_kopecks,
+                     confirmed_kopecks, returned_kopecks, status, mode, source_type, source_id)
+                VALUES (?, ?, ?, ?, ?, ?, ?, 'SHADOW', 'PAYMENT_LINK', ?)
+                """, id, taskId, profileId, amount, confirmed, returned, status, sourceId);
+    }
+
+    private void insertAttribution(
+            Long id,
+            Long taskId,
+            Long profileId,
+            Long originalAllocationId,
+            long amount
+    ) {
+        jdbc.update("""
+                INSERT INTO contractor_actual_payment_attributions
+                    (id, actual_cash_destination_kind,
+                     actual_manual_payment_task_target_kind,
+                     actual_manual_payment_task_id, actual_recipient_profile_id,
+                     original_allocation_id, accounting_mode, amount_kopecks)
+                VALUES (?, 'MANUAL_PAYMENT_TASK', 'SPECIALIST', ?, ?, ?, 'SHADOW', ?)
+                """, id, taskId, profileId, originalAllocationId, amount);
+    }
