+    private Binding lockArchivedActualPaymentBinding(
+            ContractorActualPaymentAttribution snapshot,
+            ContractorPaymentAllocation allocation
+    ) {
+        lockArchivedSource(snapshot.getSourceKind(), snapshot.getSourceId());
