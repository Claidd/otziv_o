+    private long targetAvailable(ContractorPaymentProfile profile, long ownPending) {
+        if (profile == null) {
+            return 0;
+        }
+        long available = Math.max(0,
+                contractorPaymentProfileService.available(profile, ContractorAllocationMode.LIVE));
+        try {
+            return Math.addExact(available, ownPending);
+        } catch (ArithmeticException overflow) {
+            return Long.MAX_VALUE;
+        }
+    }
+
+    private long saturatedSubtract(long left, long right) {
