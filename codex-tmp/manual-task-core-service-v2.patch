+    private void validateAccountingTargetForActivation(ManualPaymentTask task) {
+        if (!hasResolvedAccountingTarget(task)) {
+            throw new ResponseStatusException(
+                    HttpStatus.CONFLICT,
+                    "Привяжите точного получателя платёжного задания"
+            );
