+                User targetUser = profile == null ? null : profile.getUser();
+                String fio = targetUser == null ? "" : normalize(targetUser.getFio());
+                yield fio.isBlank() && targetUser != null ? normalize(targetUser.getUsername()) : fio;
+            }
+        };
+    }
