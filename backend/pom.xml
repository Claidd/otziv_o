		</dependency>

		<!-- ПАРСЕР -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.23.2</version>
		</dependency>
		<!-- Explicit HTTP transport: the crawler pins each validated DNS answer to the
		     socket connection, preventing DNS-rebinding between validation and connect. -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>

		<!-- PDF export -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
