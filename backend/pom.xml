			<version>0.4.21</version>
		</dependency>
		<dependency> <!--Телеграмм бот-->
			<groupId>org.telegram</groupId>
			<artifactId>telegrambots</artifactId>
			<version>6.9.7.1</version>
			<!-- The application uses the long-polling BotSession; no Telegram webhook HTTP server. -->
			<exclusions>
				<exclusion>
					<groupId>org.glassfish.jersey.containers</groupId>
					<artifactId>jersey-container-grizzly2-http</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>3.6.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.0.3</version>
                        </dependency>
                    </dependencies>
                </plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>3.22.0</version>
				<dependencies>
					<dependency>
						<groupId>org.jsoup</groupId>
						<artifactId>jsoup</artifactId>
						<version>1.23.2</version>
					</dependency>
					<dependency>
						<groupId>commons-beanutils</groupId>
						<artifactId>commons-beanutils</artifactId>
						<version>1.11.0</version>
					</dependency>
				</dependencies>
				</plugin>
			</plugins>
		</pluginManagement>
		<finalName>otziv-1</finalName> <!-- 👈 добавь это -->
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>tools.jackson.core</groupId>
                        <artifactId>jackson-core</artifactId>
                        <version>3.1.6</version>
                    </dependency>
                    <dependency>
                        <groupId>tools.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                        <version>3.1.6</version>
                    </dependency>
                    <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><version>5.6.4</version></dependency>
                    <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5</artifactId><version>5.4.3</version></dependency>
                    <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5-h2</artifactId><version>5.4.3</version></dependency>
                    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.20.0</version></dependency>
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>3.6.2</version>
                    </dependency>
                </dependencies>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration combine.self="override">
					<release>${java.version}</release>
					<parameters>true</parameters>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-java-runtime</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[26,27)</version>
								</requireJavaVersion>
								<dependencyConvergence>
									<includes>
										<include>io.netty:*</include>
										<include>org.apache.tomcat.embed:*</include>
										<include>org.apache.httpcomponents.core5:*</include>
										<include>org.apache.httpcomponents.client5:*</include>
									</includes>
								</dependencyConvergence>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>security-audit</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<executions>
							<execution>
								<id>require-security-audit-credentials</id>
								<phase>validate</phase>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireEnvironmentVariable>
											<variableName>SONATYPE_GUIDE_TOKEN</variableName>
											<regex>\S+</regex>
											<message>The security-audit lifecycle requires SONATYPE_GUIDE_TOKEN from the approved secret mechanism.</message>
											<regexMessage>SONATYPE_GUIDE_TOKEN must be nonblank and contain no whitespace.</regexMessage>
										</requireEnvironmentVariable>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>13.0.0</version>
						<!-- Plugin realms do not inherit the application's dependencyManagement. -->
						<dependencies>
							<dependency>
								<groupId>com.fasterxml.jackson.core</groupId>
								<artifactId>jackson-core</artifactId>
								<version>2.22.2</version>
							</dependency>
							<dependency>
								<groupId>com.fasterxml.jackson.core</groupId>
								<artifactId>jackson-databind</artifactId>
								<version>2.22.2</version>
							</dependency>
							<dependency>
								<groupId>org.jsoup</groupId>
								<artifactId>jsoup</artifactId>
								<version>1.23.2</version>
							</dependency>
							<dependency>
								<groupId>org.apache.httpcomponents.client5</groupId>
								<artifactId>httpclient5</artifactId>
								<version>${httpclient5.version}</version>
							</dependency>
						</dependencies>
						<configuration>
							<scanPlugins>true</scanPlugins>
							<nvdDatafeedUrl>https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz</nvdDatafeedUrl>
							<ossIndexServerId>otziv-sonatype</ossIndexServerId>
							<ossIndexWarnOnlyOnRemoteErrors>false</ossIndexWarnOnlyOnRemoteErrors>
							<suppressionFiles>
								<suppressionFile>${project.basedir}/../infrastructure/runtime-security/maven-false-positives.xml</suppressionFile>
							</suppressionFiles>
							<skipTestScope>false</skipTestScope>
							<skipProvidedScope>false</skipProvidedScope>
							<skipSystemScope>false</skipSystemScope>
							<formats>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
							<failBuildOnCVSS>7.0</failBuildOnCVSS>
							<dataDirectory>${project.build.directory}/dependency-check-data</dataDirectory>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<repositories>
		<repository>
			<id>maven_central</id>
			<name>Maven Central</name>
			<url>https://repo.maven.apache.org/maven2/</url>
		</repository>
	</repositories>

</project>
