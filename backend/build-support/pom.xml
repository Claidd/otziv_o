<plugins>
    <!-- Direct audit/preflight goals are explicit roots so their runtime dependencies are covered. -->
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-help-plugin</artifactId></plugin>
    <plugin><groupId>com.hunt.build</groupId><artifactId>dependency-check-effective-maven-plugin</artifactId></plugin>
