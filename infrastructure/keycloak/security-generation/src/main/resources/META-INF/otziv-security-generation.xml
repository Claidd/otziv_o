<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
  <changeSet id="otziv-security-generation-1" author="otziv">
    <createTable tableName="OTZIV_SEC_GENERATION">
      <column name="ID" type="VARCHAR(64)"><constraints nullable="false" primaryKey="true" primaryKeyName="PK_OTZIV_SEC_GENERATION"/></column>
      <column name="REALM_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="SUBJECT_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="GENERATION" type="BIGINT"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="OTZIV_SEC_GENERATION" columnNames="REALM_ID,SUBJECT_ID" constraintName="UK_OTZIV_SEC_GENERATION_SUBJECT"/>
  </changeSet>
</databaseChangeLog>
