[Unit]
Description=Ensure Otziv production Docker Compose services are running
Documentation=file:@@OTZIV_DEPLOY_PATH@@/docker-compose.yaml
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@OTZIV_DEPLOY_PATH@@
ExecStart=/usr/local/sbin/otziv-prod-up.sh
TimeoutStartSec=300
Nice=5

[Install]
WantedBy=multi-user.target
