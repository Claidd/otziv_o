{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "availability",
      "folder": "Otziv",
      "interval": "1m",
      "rules": [
        {
          "uid": "otziv-app-down",
          "title": "OtzivAppDown",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "up{job=\"app\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Приложение не отвечает Prometheus 5 минут",
            "description": "Проверьте контейнер app, его журнал и healthcheck. Короткий перерыв во время деплоя ожидаем, 5 минут уже нет."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-keycloak-down",
          "title": "OtzivKeycloakDown",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "up{job=\"keycloak\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Keycloak не отвечает Prometheus 5 минут",
            "description": "Без Keycloak пользователи не могут войти. Проверьте контейнеры keycloak и keycloak-db."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-process-restart-loop",
          "title": "OtzivProcessRestartLoop",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 1800,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "changes(process_start_time_seconds{job=~\"app|keycloak\"}[30m])",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Процесс {{ .Labels.job }} перезапускался {{ with .Values.B }}{{ .Value }} {{ end }}раз за 30 минут",
            "description": "Один перезапуск бывает при деплое, повторные говорят о падении. Смотрите журнал контейнера перед перезапуском."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-container-restarts",
          "title": "OtzivContainerRestarted",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "increase(otziv_container_restarts_total[15m])",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Docker перезапустил контейнер {{ .Labels.service }} ({{ .Labels.container }})",
            "description": "Перезапуск по restart policy означает падение процесса, в том числе по памяти. Пересоздание при деплое сюда не попадает."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-container-unhealthy",
          "title": "OtzivContainerUnhealthy",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "otziv_container_health_status{status=\"unhealthy\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "3m",
          "annotations": {
            "summary": "Контейнер {{ .Labels.service }} не проходит healthcheck 3 минуты",
            "description": "Проверьте журнал контейнера {{ .Labels.container }} и его зависимости."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-monitoring-source-down",
          "title": "OtzivMonitoringSourceDown",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "up{job=~\"containers|host\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "Нет метрик {{ .Labels.job }}: проверки контейнеров или хоста не работают",
            "description": "containers отдаёт docker-observer, host отдаёт Alloy. Пока источника нет, алерты о перезапусках, диске и памяти молчат."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "resources",
      "folder": "Otziv",
      "interval": "1m",
      "rules": [
        {
          "uid": "otziv-host-disk-low",
          "title": "OtzivHostDiskLow",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "min by (device) (node_filesystem_avail_bytes{job=\"host\"} / node_filesystem_size_bytes{job=\"host\"})",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "На диске хоста осталось {{ with .Values.B }}{{ humanizePercentage .Value }}{{ else }}меньше 10%{{ end }} места",
            "description": "Диск с томами Docker и журналами приложения. Без места останавливаются MySQL, бэкапы и журналы."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-host-memory-low",
          "title": "OtzivHostMemoryLow",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "node_memory_MemAvailable_bytes{job=\"host\"} / node_memory_MemTotal_bytes{job=\"host\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "Свободной памяти хоста {{ with .Values.B }}{{ humanizePercentage .Value }}{{ else }}меньше 10%{{ end }}",
            "description": "При нехватке памяти ядро завершает контейнеры, первыми наблюдаемость, затем сервисы."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-jvm-old-gen-high",
          "title": "OtzivJvmHeapHigh",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (job, instance) (jvm_gc_live_data_size_bytes{job=\"app\"} / jvm_gc_max_data_size_bytes{job=\"app\"})",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.9
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "annotations": {
            "summary": "После сборки мусора занято {{ with .Values.B }}{{ humanizePercentage .Value }}{{ else }}больше 90%{{ end }} старой кучи приложения",
            "description": "Живые данные почти заполнили кучу: вероятна утечка или нехватка памяти, дальше OutOfMemoryError."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "backups",
      "folder": "Otziv",
      "interval": "5m",
      "rules": [
        {
          "uid": "otziv-backup-failed",
          "title": "OtzivBackupFailed",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 7200,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "increase(otziv_backup_failures_total[2h])",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Бэкап БД завершился ошибкой ({{ .Labels.trigger }})",
            "description": "Ошибку пишет журнал приложения: Daily database backup failed или Database backup catch-up failed. Догоняющий запуск повторяется каждые 15 минут."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "otziv-backup-stale",
          "title": "OtzivBackupStale",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "time() - otziv_backup_last_verified_epoch",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        97200
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "annotations": {
            "summary": "Нет подтверждённого бэкапа {{ .Labels.database }} больше 27 часов",
            "description": "Ежедневный бэкап не дошёл до проверки. Проверьте журнал приложения, хранилище S3 и файл подтверждений в backup.work-dir."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "logs",
      "folder": "Otziv",
      "interval": "1m",
      "rules": [
        {
          "uid": "otziv-error-log-burst",
          "title": "OtzivErrorLogBurst",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(logback_events_total{job=\"app\",level=\"error\"}[15m])) > 20 and sum(increase(logback_events_total{job=\"app\",level=\"error\"}[15m])) > 3 * sum(increase(logback_events_total{job=\"app\",level=\"error\"}[1d] offset 15m)) / 96",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": ""
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "В журнале приложения {{ with .Values.B }}{{ humanize .Value }}{{ else }}больше 20{{ end }} ошибок за 15 минут",
            "description": "Это больше 20 и втрое больше среднего за прошлые сутки. Смотрите уровень ERROR в Loki."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "client-delivery",
      "folder": "Otziv",
      "interval": "30s",
      "rules": [
        {
          "uid": "otziv-client-delivery-queue-delayed",
          "title": "ClientDeliveryQueueDelayed",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "otziv_delivery_queue_oldest_seconds{state=~\"QUEUED|RETRYABLE\",queue!=\"whatsapp_unlinked\"}",
                "instant": true,
                "range": false
