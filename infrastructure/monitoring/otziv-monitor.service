[Unit]
Description=External Otziv availability, backup and delivery monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=otziv-monitor
Group=otziv-monitor
EnvironmentFile=/etc/otziv-monitor/secrets.env
ExecStart=/usr/bin/node /opt/otziv/infrastructure/monitoring/watch.mjs /etc/otziv-monitor/config.json
StateDirectory=otziv-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
